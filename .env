# biolabs - versioned default values, no secret at all.
# Local overrides go in .env.local (not versioned):
#   APP_SECRET, DATABASE_URL (MySQL in production), etc.

###> symfony/framework-bundle ###
APP_ENV=dev
# Secret generated per machine: define it in .env.local (php -r "echo bin2hex(random_bytes(16));")
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Development: local SQLite, no server to install.
# Production: MySQL 8 in .env.local, for example
#   DATABASE_URL="mysql://utilisateur:motdepasse@127.0.0.1:3306/biolabs?serverVersion=8.0&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###
