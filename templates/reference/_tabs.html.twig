<nav class="tabs" aria-label="{{ (group ~ '.tabs')|trans }}">
    <ul>
        {% for slug in types %}
            <li><a href="{{ path('app_' ~ group ~ '_index', {type: slug}) }}"{% if slug == type %} aria-current="page"{% endif %}>{{ ('reference.type.' ~ slug)|trans }}</a></li>
        {% endfor %}
    </ul>
</nav>
